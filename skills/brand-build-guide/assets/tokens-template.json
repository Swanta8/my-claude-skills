{
  "brand": "[BRAND_NAME]",
  "brand_prefix": "[BRAND_PREFIX]",
  "version": "[YYYY-MM-DD]",
  "parent_group": "[PARENT_OR_NULL]",
  "sister_entities": ["[SISTER_OR_EMPTY]"],
  "tagline": null,

  "colors": {
    "primary": "#PRIMARY",
    "accent": "#ACCENT",
    "text_body": "#TEXT_BODY",
    "text_heading": "#TEXT_HEADING",
    "text_muted": "#TEXT_MUTED",
    "bg_page": "#BG_PAGE",
    "bg_card": "#FFFFFF",
    "border": "#BORDER",
    "border_mail": "#BORDER_MAIL",
    "soft_fill": "#SOFT_FILL",
    "zebra": "#ZEBRA",
    "link": "#LINK",
    "link_safe": "#LINK_SAFE",
    "status_positive": "#POSITIVE",
    "status_positive_soft": "#POSITIVE_SOFT",
    "status_negative": "#NEGATIVE",
    "status_negative_soft": "#NEGATIVE_SOFT",
    "status_warn": "#WARN",
    "status_warn_soft": "#WARN_SOFT"
  },

  "typography": {
    "primary_font_stack": "'PRIMARY_FONT', Arial, Helvetica, sans-serif",
    "email_font_stack": "Arial, 'PRIMARY_FONT', Helvetica, sans-serif",
    "fallback_word": "Calibri",
    "fallback_powerpoint": "Arial",
    "google_fonts_url": null,
    "sizes": {
      "title_h1": "1.45rem",
      "title_email": "18px",
      "title_pptx": "32pt",
      "block_title": "1.05rem",
      "body": "14px",
      "body_pdf": "12px",
      "caption": "11px",
      "footer": "13px"
    },
    "weights": {
      "title": 800,
      "label": 700,
      "body": 400
    }
  },

  "spacing": {
    "outer_padding": "24px 12px",
    "card_padding_pdf": "22px",
    "card_padding_email": "18px 22px",
    "table_cell_padding": "10px 12px",
    "block_gap": "8px",
    "page_margin_pdf": "14mm 12mm 16mm 12mm"
  },

  "radius": {
    "card": "12px",
    "inner": "10px",
    "pill": "999px",
    "chip": "3px",
    "photo": "12px"
  },

  "shadow": {
    "email_card": "0 4px 12px rgba(0,0,0,.08)",
    "pdf_container": "0 6px 18px rgba(0,0,0,.08)"
  },

  "logo": {
    "url": "https://[LIVE_HTTPS_URL]",
    "url_dark_variant": null,
    "max_width_email_footer": "160px",
    "max_width_pdf_footer": "120px",
    "max_width_email_signature_photo": "80px",
    "alt_text": "[BRAND_NAME] logo"
  },

  "footer": {
    "company": "[BRAND_NAME]",
    "address": "[ADDRESS_OR_EMPTY]",
    "phone": "[PHONE_OR_EMPTY]",
    "website": "[WEBSITE_URL]",
    "website_display": "[WEBSITE_DISPLAY]",
    "kvk": null,
    "btw": null,
    "render_rules": "Omit empty lines completely; never render a blank row."
  },

  "container_widths": {
    "email": "680px",
    "pdf": "900px",
    "html_report": "900px",
    "dashboard": "1200px"
  },

  "localization": {
    "primary_language": "nl",
    "date_long": "maandag 11 mei 2026",
    "date_short": "11 mei 2026",
    "thousands_separator": ".",
    "decimal_separator": ",",
    "currency_format": "€ 1.230,45"
  },

  "sister_rebrand_mapping": {
    "_comment": "Vul in als rebrand-functionaliteit nodig is. Anders verwijderen.",
    "source_brand": "[BRON_MERK]",
    "primary": "#TARGET_PRIMARY",
    "accent": "#TARGET_ACCENT",
    "text_dark": "#TARGET_TEXT",
    "logo_url": "https://[TARGET_LOGO_URL]"
  }
}
